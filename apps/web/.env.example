NEXT_PUBLIC_API_URL=/api
# Server-only NestJS origin, used for initial catalog loading and /api rewrites.
API_INTERNAL_URL=http://127.0.0.1:3000
# Authorized VIETMAP MapLibre vector styles; prefer a native dark style.
NEXT_PUBLIC_MAP_DARK_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional limited campus illustration for offline demos; default uses OpenFreeMap Dark.
NEXT_PUBLIC_MAP_OFFLINE=false
